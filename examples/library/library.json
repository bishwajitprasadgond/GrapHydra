    {"id":"s-archive","labels":["Series"],"properties":{"name":"The Archive Cycle"}},
    {"id":"c-ines","labels":["Character"],"properties":{"name":"Ines Duarte","role":"archivist"}},
    {"id":"c-bram","labels":["Character"],"properties":{"name":"Bram Holt","role":"clockmaker"}},
    {"id":"c-sela","labels":["Character"],"properties":{"name":"Sela Moor","role":"cartographer"}},
    {"id":"b-archive","labels":["Book"],"properties":{"isbn":"978-0-00-000001-1","pages":10,"title":"The Clockwork Archive","year":2019}},
    {"id":"b-archive-ch1","labels":["Chapter"],"properties":{"book":"The Clockwork Archive","number":1,"title":"The Ledger Room"}},
    {"id":"b-archive-p1","labels":["Page"],"properties":{"book":"The Clockwork Archive","number":1,"text":"Ines Duarte unlocked the ledger room an hour before the bells, as she had every morning for nine years.","words":19}},
    {"id":"b-archive-p2","labels":["Page"],"properties":{"book":"The Clockwork Archive","number":2,"text":"The newest ledger was missing. In its place sat a brass key no longer than her thumb.","words":17}},
    {"id":"b-archive-p3","labels":["Page"],"properties":{"book":"The Clockwork Archive","number":3,"text":"She knew one clockmaker in the city who still cut keys by hand: Bram Holt.","words":15}},
    {"id":"b-archive-ch2","labels":["Chapter"],"properties":{"book":"The Clockwork Archive","number":2,"title":"A Key Without a Lock"}},
    {"id":"b-archive-p4","labels":["Page"],"properties":{"book":"The Clockwork Archive","number":4,"text":"Bram Holt turned the key under his loupe and said it opened nothing he had ever built.","words":17}},
    {"id":"b-archive-p5","labels":["Page"],"properties":{"book":"The Clockwork Archive","number":5,"text":"Its teeth, he insisted, were not teeth at all but a date written in gears.","words":15}},
    {"id":"b-archive-p6","labels":["Page"],"properties":{"book":"The Clockwork Archive","number":6,"text":"Ines copied the date into her notebook: the night the old archive burned.","words":13}},
    {"id":"b-archive-p7","labels":["Page"],"properties":{"book":"The Clockwork Archive","number":7,"text":"Someone wanted the fire remembered, and wanted her to be the one remembering.","words":13}},
    {"id":"b-archive-ch3","labels":["Chapter"],"properties":{"book":"The Clockwork Archive","number":3,"title":"Ashes in the Catalogue"}},
    {"id":"b-archive-p8","labels":["Page"],"properties":{"book":"The Clockwork Archive","number":8,"text":"The fire report listed every shelf as lost except one, catalogued as empty.","words":13}},
    {"id":"b-archive-p9","labels":["Page"],"properties":{"book":"The Clockwork Archive","number":9,"text":"An empty shelf does not need a lock, Ines thought, unless something was hidden there after.","words":16}},
    {"id":"b-archive-p10","labels":["Page"],"properties":{"book":"The Clockwork Archive","number":10,"text":"Behind the shelf Ines Duarte found a second ledger, written in Bram Holt's careful hand.","words":15}},
    {"id":"b-rivers","labels":["Book"],"properties":{"isbn":"978-0-00-000002-8","pages":6,"title":"Rivers of Glass","year":2022}},
    {"id":"b-rivers-ch1","labels":["Chapter"],"properties":{"book":"Rivers of Glass","number":1,"title":"Maps That Move"}},
    {"id":"b-rivers-p1","labels":["Page"],"properties":{"book":"Rivers of Glass","number":1,"text":"Sela Moor drew maps of a city whose rivers changed course every winter.","words":13}},
    {"id":"b-rivers-p2","labels":["Page"],"properties":{"book":"Rivers of Glass","number":2,"text":"Her latest map showed a river where the old archive had stood.","words":12}},
    {"id":"b-rivers-p3","labels":["Page"],"properties":{"book":"Rivers of Glass","number":3,"text":"Sela Moor brought it to Ines Duarte, who recognised the brass key etched in the margin.","words":16}},
    {"id":"b-rivers-ch2","labels":["Chapter"],"properties":{"book":"Rivers of Glass","number":2,"title":"The Glass Current"}},
    {"id":"b-rivers-p4","labels":["Page"],"properties":{"book":"Rivers of Glass","number":4,"text":"Under the ice the river ran clear as glass and carried the ledgers' ashes downstream.","words":15}},
    {"id":"b-rivers-p5","labels":["Page"],"properties":{"book":"Rivers of Glass","number":5,"text":"Ines realised the second ledger was not a record of the fire but a plan for it.","words":17}},
    {"id":"b-rivers-p6","labels":["Page"],"properties":{"book":"Rivers of Glass","number":6,"text":"Bram Holt had not started the fire. He had timed it.","words":11}},
    {"id":"b-machines","labels":["Book"],"properties":{"isbn":"978-0-00-000003-5","pages":8,"title":"A Field Guide to Small Machines","year":2015}},
    {"id":"b-machines-ch1","labels":["Chapter"],"properties":{"book":"A Field Guide to Small Machines","number":1,"title":"Escapements"}},
    {"id":"b-machines-p1","labels":["Page"],"properties":{"book":"A Field Guide to Small Machines","number":1,"text":"An escapement releases a clock's stored energy one tooth at a time.","words":12}},
    {"id":"b-machines-p2","labels":["Page"],"properties":{"book":"A Field Guide to Small Machines","number":2,"text":"The anchor escapement made pendulum clocks accurate enough for navigation.","words":10}},
    {"id":"b-machines-p3","labels":["Page"],"properties":{"book":"A Field Guide to Small Machines","number":3,"text":"Hand-cut escapements show tool marks that identify individual makers.","words":9}},
    {"id":"b-machines-ch2","labels":["Chapter"],"properties":{"book":"A Field Guide to Small Machines","number":2,"title":"Locks and Keys"}},
    {"id":"b-machines-p4","labels":["Page"],"properties":{"book":"A Field Guide to Small Machines","number":4,"text":"A lever lock opens only when every lever is lifted to exactly the right height.","words":15}},
    {"id":"b-machines-p5","labels":["Page"],"properties":{"book":"A Field Guide to Small Machines","number":5,"text":"Some makers encoded dates or names in the bitting of a key as a signature.","words":15}},
    {"id":"b-machines-p6","labels":["Page"],"properties":{"book":"A Field Guide to Small Machines","number":6,"text":"Such signature keys open nothing; they exist to be recognised.","words":10}},
    {"id":"b-machines-ch3","labels":["Chapter"],"properties":{"book":"A Field Guide to Small Machines","number":3,"title":"Repair and Restoration"}},
    {"id":"b-machines-p7","labels":["Page"],"properties":{"book":"A Field Guide to Small Machines","number":7,"text":"Restoring a movement begins with a full record of its condition.","words":11}},
    {"id":"b-machines-p8","labels":["Page"],"properties":{"book":"A Field Guide to Small Machines","number":8,"text":"Replace only what is broken, and document every replacement part.","words":10}}
  ],
