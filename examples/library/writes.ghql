// Write examples: add a chapter with pages, edit, link, and delete.
// Run on a copy so the read-only examples keep their expected output:
//
//   graphydra query library-copy.graph -f examples/library/writes.ghql
//
// The whole script below is applied statement by statement; each statement is atomic.

// 1. Add chapter 4 to "The Clockwork Archive" and link it after chapter 3
MATCH (b:Book {title: "The Clockwork Archive"}), (prev:Chapter {book: "The Clockwork Archive", number: 3})
CREATE (b)-[:HAS_CHAPTER {order: 4}]->(c:Chapter {id: "b-archive-ch4", title: "The Second Ledger", number: 4, book: "The Clockwork Archive"}),
       (prev)-[:NEXT]->(c)
RETURN c;

// 2. Add two pages to the new chapter, continuing the page numbering
MATCH (c:Chapter {id: "b-archive-ch4"}), (last:Page {book: "The Clockwork Archive", number: 10})
CREATE (c)-[:HAS_PAGE {order: 1}]->(p11:Page {id: "b-archive-p11", number: 11, book: "The Clockwork Archive", words: 9,
                                                text: "Ines read the second ledger until the bells rang."}),
       (c)-[:HAS_PAGE {order: 2}]->(p12:Page {id: "b-archive-p12", number: 12, book: "The Clockwork Archive", words: 10,
                                                text: "Bram Holt was waiting for her at the archive door."}),
       (last)-[:NEXT]->(p11),
       (p11)-[:NEXT]->(p12)
RETURN p11.number, p12.number;

// 3. Record which characters the new pages mention
MATCH (p:Page {id: "b-archive-p12"}), (bram:Character {name: "Bram Holt"})
CREATE (p)-[:MENTIONS]->(bram);

// 4. Update a book: keep its page count in sync and mark it revised
MATCH (b:Book {title: "The Clockwork Archive"})
SET b.pages = 12, b.edition = 2, b:Revised
RETURN b.title, b.pages, labels(b);

// 5. Fix a typo in one page's text
MATCH (p:Page {id: "b-archive-p11"})
SET p.text = "Ines read the second ledger until the morning bells rang.", p.words = 10
RETURN p.text;

// 6. Remove a property and a label
MATCH (b:Book {title: "The Clockwork Archive"})
REMOVE b.edition, b:Revised
RETURN b;

// 7. Delete a page together with all of its relationships
MATCH (p:Page {id: "b-archive-p12"})
DETACH DELETE p;

// 8. Count what is left
MATCH (b:Book {title: "The Clockwork Archive"})-[:HAS_CHAPTER]->(c:Chapter)-[:HAS_PAGE]->(p:Page)
RETURN count(DISTINCT c) AS chapters, count(p) AS pages;
