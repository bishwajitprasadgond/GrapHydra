    def update_node(self, id: str, properties: Properties) -> None: ...
    def set_edge_property(self, id: str, key: str, value: PropertyValue) -> None: ...
    def update_edge(self, id: str, properties: Properties) -> None: ...
    def add_label(self, id: str, label: str) -> None: ...
    def remove_label(self, id: str, label: str) -> None: ...
    def delete_node(self, id: str, detach: bool = False) -> int: ...
