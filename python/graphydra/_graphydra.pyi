    def create_index(self, property: str, *, kind: IndexKind = "hash", target: IndexTarget = "node") -> None: ...
    def drop_index(self, property: str, *, kind: IndexKind = "hash", target: IndexTarget = "node") -> None: ...
    def indexes(self) -> list[dict[str, Any]]: ...
