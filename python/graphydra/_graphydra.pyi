"""Type stubs for the native GrapHydra extension."""

from collections.abc import Iterable, Iterator, Mapping, Sequence
from os import PathLike
from types import TracebackType
from typing import Any, Literal, Optional, Union

__version__: str
FORMAT_VERSION: str

PropertyValue = Union[None, bool, int, float, str, Sequence[Any], Mapping[str, Any]]
Properties = Mapping[str, PropertyValue]
StrPath = Union[str, PathLike[str]]
Direction = Literal["out", "in", "both"]
IndexKind = Literal["hash", "sorted", "text"]
IndexTarget = Literal["node", "edge"]

class GraphError(Exception): ...

class QuerySyntaxError(GraphError):
    line: int
    column: int

class QueryError(GraphError): ...
class ParameterError(QueryError): ...
class ValidationError(GraphError): ...
class FormatError(GraphError): ...
class NotFoundError(GraphError): ...
class DuplicateIdError(ValidationError): ...
class IntegrityError(ValidationError): ...
class ReadOnlyError(GraphError): ...
class LockedError(GraphError): ...
class TransactionError(GraphError): ...
class QueryTimeoutError(GraphError): ...
class CancelledError(GraphError): ...
class LimitExceededError(GraphError): ...
class StorageError(GraphError): ...
class IndexDefinitionError(GraphError): ...
class ClosedError(GraphError): ...

